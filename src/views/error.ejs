<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0" />
        <title><%= statusCode %> | <%= appName %></title>
        <link
            rel="stylesheet"
            href="/css/style.css" />
    </head>
    <body>
        <main class="container">
            <section class="welcome-card">
                <p class="eyebrow">SYSTEM // ERROR</p>
                <h1>Error <%= statusCode %></h1>
                <p><%= message %></p>
                <a
                    class="button-link"
                    href="/"
                    >Return home</a
                >
            </section>
        </main>
    </body>
</html>
