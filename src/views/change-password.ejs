<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password | <%= appName %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <main class="container">
        <section class="welcome-card auth-card">
            <p class="eyebrow">ACCOUNT SECURITY</p>
            <h1>Change password</h1>

            <p>
                Enter your current password and choose a new password
                with at least 12 characters.
            </p>

            <% if (error) { %>
                <p class="alert alert-error" role="alert">
                    <%= error %>
                </p>
                <% } %>

                    <form action="/change-password" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <label for="currentPassword">Current password</label>
                        <input id="currentPassword" name="currentPassword" type="password"
                            autocomplete="current-password" maxlength="1024" required>

                        <label for="newPassword">New password</label>
                        <input id="newPassword" name="newPassword" type="password" autocomplete="new-password"
                            minlength="12" maxlength="1024" required>

                        <label for="confirmPassword">Confirm new password</label>
                        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"
                            minlength="12" maxlength="1024" required>

                        <button class="button-primary" type="submit">
                            Update password
                        </button>
                    </form>

                    <form action="/logout" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="button-secondary" type="submit">Log out</button>
                    </form>
        </section>
    </main>
</body>

</html>